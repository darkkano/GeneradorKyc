generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model FormSchema {
  id         String   @id @db.VarChar(40)
  country    String   @db.VarChar(8)
  risk       String   @db.VarChar(8)
  activity   String   @db.VarChar(24)
  volumeUsd  Int      @map("volume_usd")
  prompt     String   @db.Text
  rationale  String   @db.Text
  schemaJson String   @map("schema_json") @db.LongText
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([country, risk])
  @@map("form_schemas")
}

model Submission {
  id        String   @id @db.VarChar(40)
  schemaId  String   @map("schema_id") @db.VarChar(40)
  country   String   @db.VarChar(8)
  risk      String   @db.VarChar(8)
  payload   String   @db.LongText
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schemaId])
  @@map("submissions")
}
